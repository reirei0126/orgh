#!/usr/bin/env python3
"""claude -p (headless) のモック。JSON封筒契約を模す。

役割はプロンプト内マーカーで分岐:
  "(Planner)" / "(Reviewer)" / "(Retro)" を含む → 各役割、それ以外 → worker

タスク識別はプロンプト中の [[MARK:<id>]]。挙動は環境変数で制御:
  MOCK_STATE_DIR          呼び出し履歴・reject-once状態の置き場(必須)
  MOCK_REJECT_ONCE        カンマ区切りマーカー: 初回レビューのみ差し戻し
  MOCK_REVIEW_ALWAYS_FAIL カンマ区切りマーカー: レビュー常時差し戻し
  MOCK_REVIEW_REPLAN      カンマ区切りマーカー: 初回レビューをREPLAN:差し戻し
  MOCK_REVIEW_REPLAN_ALWAYS 同上だが毎回REPLAN:差し戻し(上限試験用)
  MOCK_REPLAN_JSON        Planner再設計応答の上書き(inline JSON)
  MOCK_RETRO_JSON         Retro応答の上書き(inline JSON)
  MOCK_GC_JSON            統合Retro(GC)応答の上書き(inline JSON)
  MOCK_WORKER_FAIL        カンマ区切りマーカー: worker実行が常にエラー
  MOCK_PLAN_JSON          Planner応答の上書き(inline JSON か ファイルパス)
  MOCK_PLANNER_FAIL       "1" ならPlannerがis_errorを返す(着火前失敗試験用)
  MOCK_NO_SLEEP           "1" なら sleep 系を全て無視(resume試験用)
  MOCK_SLEEP_ALL          秒数: workerロールの呼び出しを常にsleep
                          (リトライプロンプトでマーカーが失われても眠らせ続ける)
  MOCK_CLAUDE_AUTH        "ok"(既定)/"failed": `auth status --json` 呼び出し
                          (orgh doctor の非対話認証確認)への応答を切り替える

プロンプト中の [[SLEEP:<秒>]] で応答前に sleep(タイムアウト/kill試験用)。
[[WRITE:<相対パス>:<内容>]] でworkerがcwdにファイルを書く(worktree分離試験用)。
全呼び出しは cwd 付きで calls.jsonl に記録される。
"""
import json
import os
import re
import sys
import time
from pathlib import Path


def _env_set(name: str) -> set[str]:
    v = os.environ.get(name, "")
    return {x.strip() for x in v.split(",") if x.strip()}


def _state_dir() -> Path:
    d = Path(os.environ.get("MOCK_STATE_DIR", ".mock_state"))
    d.mkdir(parents=True, exist_ok=True)
    return d


def _log_call(state: Path, rec: dict) -> None:
    rec["ts"] = time.time()
    rec["cwd"] = os.getcwd()
    with open(state / "calls.jsonl", "a") as f:
        f.write(json.dumps(rec, ensure_ascii=False) + "\n")


def _envelope(result: str, session_id: str | None = None,
              is_error: bool = False) -> str:
    return json.dumps({
        "type": "result",
        "is_error": is_error,
        "result": result,
        "session_id": session_id,
        "total_cost_usd": 0.01,
    }, ensure_ascii=False)


def main() -> int:
    args = sys.argv[1:]

    if args == ["auth", "status", "--json"]:
        # doctor の非対話認証確認(orgh/doctor.py _check_worker_auth)。
        # 実プロンプト処理には入らず、ここで即応答する
        logged_in = os.environ.get("MOCK_CLAUDE_AUTH", "ok") != "failed"
        print(json.dumps({"loggedIn": logged_in, "authMethod": "claude.ai"},
                         ensure_ascii=False))
        return 0

    resume = None
    if "--resume" in args:
        resume = args[args.index("--resume") + 1]

    prompt = sys.stdin.read()
    m = re.search(r"\[\[MARK:([\w-]+)\]\]", prompt)
    marker = m.group(1) if m else "none"
    state = _state_dir()

    sm = re.search(r"\[\[SLEEP:(\d+(?:\.\d+)?)\]\]", prompt)
    if sm and os.environ.get("MOCK_NO_SLEEP") != "1":
        time.sleep(float(sm.group(1)))

    if "(Planner)" in prompt and "REPLAN理由" in prompt:
        # タスク再設計(REPLAN)への応答
        _log_call(state, {"role": "planner", "kind": "replan",
                          "marker": marker, "resume": resume})
        spec = os.environ.get("MOCK_REPLAN_JSON", "")
        out = spec or json.dumps({
            "prompt": f"再設計済みの指示 [[MARK:{marker}]]",
            "acceptance": ["機械検証可能な条件: 成果物ファイルが存在する"],
        }, ensure_ascii=False)
        print(_envelope(out, session_id="sess-replan"))
        return 0

    if "(Planner)" in prompt:
        _log_call(state, {"role": "planner", "marker": marker, "resume": resume})
        if os.environ.get("MOCK_PLANNER_FAIL") == "1":
            print(_envelope("simulated planner failure", is_error=True))
            return 0
        spec = os.environ.get("MOCK_PLAN_JSON", "")
        if spec.lstrip().startswith("{"):
            plan = spec
        elif spec:
            plan = Path(spec).read_text()
        else:
            plan = json.dumps({"tasks": [{
                "id": "w1", "title": "mock task",
                "prompt": "モックタスクを実行 [[MARK:w1]]",
                "worker": "claude_code", "deps": [],
                "acceptance": ["mock acceptance"], "workdir": ".",
            }]}, ensure_ascii=False)
        print(_envelope(plan, session_id="sess-planner"))
        return 0

    if "(Reviewer)" in prompt:
        # レビュアー呼び出し自体の失敗を模擬(最初のN回はis_errorを返す。
        # MOCK_REVIEWER_FAIL_TIMES=N。役割リトライの試験用)
        rv_times = int(os.environ.get("MOCK_REVIEWER_FAIL_TIMES", "0"))
        if rv_times:
            cf = state / f"reviewer_fail_count_{marker}"
            n = int(cf.read_text()) if cf.exists() else 0
            if n < rv_times:
                cf.write_text(str(n + 1))
                _log_call(state, {"role": "reviewer", "marker": marker,
                                  "resume": resume, "ok": False})
                print(_envelope("Reached maximum number of turns (15)",
                                is_error=True))
                return 0
        reject_once = marker in _env_set("MOCK_REJECT_ONCE")
        always_fail = marker in _env_set("MOCK_REVIEW_ALWAYS_FAIL")
        replan_once = marker in _env_set("MOCK_REVIEW_REPLAN")
        replan_always = marker in _env_set("MOCK_REVIEW_REPLAN_ALWAYS")
        once_flag = state / f"reviewed_once_{marker}"
        replan_flag = state / f"replan_once_{marker}"
        if replan_always or (replan_once and not replan_flag.exists()):
            replan_flag.touch()
            verdict = {"pass": False,
                       "feedback": f"REPLAN: acceptanceが主観的で検証不能 "
                                   f"[[MARK:{marker}]]"}
            _log_call(state, {"role": "reviewer", "marker": marker,
                              "resume": resume, "passed": False,
                              "replan": True})
            print(_envelope(json.dumps(verdict, ensure_ascii=False),
                            session_id="sess-reviewer"))
            return 0
        # feedbackにマーカーを埋め込む: 差し戻し後の再実行プロンプトは
        # feedback文で構築されるため、これがないと2回目以降のタスク識別が切れる
        if always_fail:
            verdict = {"pass": False,
                       "feedback": f"モック差し戻し(常時fail): [[MARK:{marker}]]"}
        elif reject_once and not once_flag.exists():
            once_flag.touch()
            verdict = {"pass": False,
                       "feedback": f"モック差し戻し(初回のみ): [[MARK:{marker}]] を修正せよ"}
        else:
            verdict = {"pass": True, "feedback": ""}
        _log_call(state, {"role": "reviewer", "marker": marker,
                          "resume": resume, "passed": verdict["pass"]})
        print(_envelope(json.dumps(verdict, ensure_ascii=False),
                        session_id="sess-reviewer"))
        return 0

    if "(GC)" in prompt:
        # playbook統合Retro(orgh gc)への応答
        _log_call(state, {"role": "gc", "marker": marker, "resume": resume})
        out = os.environ.get("MOCK_GC_JSON") or json.dumps(
            {"lessons": "- 統合済みの教訓"}, ensure_ascii=False)
        print(_envelope(out, session_id="sess-gc"))
        return 0

    if "(Retro)" in prompt:
        _log_call(state, {"role": "retro", "marker": marker, "resume": resume})
        out = os.environ.get("MOCK_RETRO_JSON") or json.dumps(
            {"playbook_name": "general", "lessons": ""})
        print(_envelope(out, session_id="sess-retro"))
        return 0

    # worker
    _log_argv = sys.argv[1:]  # allowed_tools等のフラグ検証用
    # インフラ障害の模擬: 最初のN回は「ネットワーク断」相当のエラーを返す
    # (MOCK_INFRA_FAIL_TIMES=N。attempt非消費リトライの試験用)
    infra_times = int(os.environ.get("MOCK_INFRA_FAIL_TIMES", "0"))
    if infra_times:
        cf = state / f"infra_fail_count_{marker}"
        n = int(cf.read_text()) if cf.exists() else 0
        if n < infra_times:
            cf.write_text(str(n + 1))
            _log_call(state, {"role": "worker", "marker": marker,
                              "resume": resume, "ok": False, "infra": True})
            print(_envelope("API Error: Unable to connect to API (ENOTFOUND)",
                            is_error=True))
            return 0
    sleep_all = os.environ.get("MOCK_SLEEP_ALL")
    if sleep_all and os.environ.get("MOCK_NO_SLEEP") != "1":
        time.sleep(float(sleep_all))
    for wm in re.finditer(r"\[\[WRITE:([^:\]]+):([^\]]*)\]\]", prompt):
        fp = Path(wm.group(1))
        fp.parent.mkdir(parents=True, exist_ok=True)
        fp.write_text(wm.group(2) + "\n")
    session_id = resume or f"sess-{marker}"
    fail = marker in _env_set("MOCK_WORKER_FAIL")
    _log_call(state, {"role": "worker", "marker": marker,
                      "resume": resume, "session_id": session_id,
                      "ok": not fail, "argv": _log_argv,
                      "prompt_head": prompt[:200]})
    if fail:
        print(_envelope(f"simulated worker error: {marker}",
                        session_id=session_id, is_error=True))
        return 0  # claudeはis_errorでもrc 0のことがある。封筒側で判定させる
    print(_envelope(f"WORKER_DONE {marker}: 変更を実施し受け入れ条件を満たした",
                    session_id=session_id))
    return 0


if __name__ == "__main__":
    sys.exit(main())
